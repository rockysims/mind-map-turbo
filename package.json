{
  "name": "mind-map-turbo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "check:offline-shell": "node apps/mind-map-sv/scripts/check-offline-shell-fresh.mjs",
    "dev": "turbo run dev",
    "dev:downloadable": "pnpm -w build && pnpm -w dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.7.4",
    "turbo": "^2.8.9",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  }
}
